{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/scripts/herdr-collab.py\"; [ -f \"$S\" ] || exit 0; python3 \"$S\" label",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/scripts/herdr-collab.py\"; [ -f \"$S\" ] || exit 0; python3 \"$S\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"${CLAUDE_PLUGIN_ROOT}/scripts/herdr-collab.py\"; [ -f \"$S\" ] || exit 0; python3 \"$S\" cleanup",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
